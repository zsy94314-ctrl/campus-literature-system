# MySQL 配置
MYSQL_DATABASE=campus_literature_system
MYSQL_ROOT_PASSWORD=change-me-strong-password

# Java 后端数据库连接
DB_URL=jdbc:mysql://mysql:3306/campus_literature_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change-me-strong-password

# JWT 密钥（部署时请替换为长随机字符串）
JWT_SECRET=change-me-to-a-long-random-string

# AI 服务地址（Docker 内部网络）
AI_SERVICE_BASE_URL=http://backend-ai:8000
