<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.literature.mapper.LiteratureMapper">

    <select id="searchLiteratures" resultType="com.campus.literature.entity.Literature">
        SELECT * FROM literature
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                OR abstract_text LIKE CONCAT('%', #{keyword}, '%')
                OR keywords LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="author != null and author != ''">
                AND authors LIKE CONCAT('%', #{author}, '%')
            </if>
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            <if test="year != null">
                AND publish_year = #{year}
            </if>
        </where>
        <choose>
            <when test="sortBy == 'year'">
                ORDER BY publish_year DESC
            </when>
            <when test="sortBy == 'citation'">
                ORDER BY citation_count DESC
            </when>
            <otherwise>
                ORDER BY id DESC
            </otherwise>
        </choose>
    </select>

</mapper>
