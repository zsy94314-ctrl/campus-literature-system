<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.literature.mapper.LiteratureMapper">

    <select id="searchLiteratures" resultType="com.campus.literature.entity.Literature">
        SELECT * FROM literature
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                OR abstract_text LIKE CONCAT('%', #{keyword}, '%')
                OR keywords LIKE CONCAT('%', #{keyword}, '%')
                OR content LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="title != null and title != ''">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="author != null and author != ''">
                AND authors LIKE CONCAT('%', #{author}, '%')
            </if>
            <if test="journal != null and journal != ''">
                AND journal LIKE CONCAT('%', #{journal}, '%')
            </if>
            <if test="doi != null and doi != ''">
                AND doi LIKE CONCAT('%', #{doi}, '%')
            </if>
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            <if test="documentType != null and documentType != ''">
                AND document_type = #{documentType}
            </if>
            <if test="startYear != null">
                AND publish_year >= #{startYear}
            </if>
            <if test="endYear != null">
                AND publish_year &lt;= #{endYear}
            </if>
            <if test="year != null and startYear == null and endYear == null">
                AND publish_year = #{year}
            </if>
        </where>
        <choose>
            <when test="sortBy == 'year_desc' or sortBy == 'year'">
                ORDER BY publish_year DESC
            </when>
            <when test="sortBy == 'year_asc'">
                ORDER BY publish_year ASC
            </when>
            <when test="sortBy == 'citation_asc'">
                ORDER BY citation_count ASC
            </when>
            <when test="sortBy == 'citation_desc' or sortBy == 'citation' or sortBy == 'citations'">
                ORDER BY citation_count DESC
            </when>
            <otherwise>
                ORDER BY id DESC
            </otherwise>
        </choose>
    </select>

</mapper>
